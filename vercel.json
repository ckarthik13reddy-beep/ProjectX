{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "runtime": "container",
      "bindings": [
        {
          "type": "service",
          "service": "server",
          "format": "url",
          "env": "PAPERCLIP_SERVER_URL"
        }
      ]
    },
    "paperclip-runner": {
      "root": "packages/paperclip-runner",
      "framework": "vite"
    },
    "server": {
      "root": "server",
      "framework": "vite"
    },
    "agent-shim": {
      "root": "tools/agent-shim",
      "runtime": "go"
    },
    "ui": {
      "root": "ui",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
