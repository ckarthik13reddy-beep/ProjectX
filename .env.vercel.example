# Vercel production/preview baseline for ProjectX
# Copy values into Vercel Project Settings -> Environment Variables.

# Required: must be a postgres/postgresql URL in authenticated public deployments.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# Required auth/session signing secret (32+ chars random string).
BETTER_AUTH_SECRET=replace-with-long-random-secret

# Required for signed tool action approvals (32+ chars random string).
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=replace-with-long-random-secret

# Serve the web UI from the same container service.
SERVE_UI=true

# Optional: keep API behavior explicit.
PORT=3100

# Optional hardening (recommended defaults).
PAPERCLIP_DEPLOYMENT_MODE=authenticated
PAPERCLIP_DEPLOYMENT_EXPOSURE=private

# Optional diagnostics tuning.
PAPERCLIP_SENTRY_RUN_FAILURES=off
